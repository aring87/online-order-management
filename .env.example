# Settings for the orders program. Copy this file to ".env" (the start scripts do this for you) and edit.

# Password for the orders program.
# Leave blank for no login screen — the program is then only reachable from this computer.
# Set a password to use it from other devices (tablet, phone) or when hosting it online.
ADMIN_PASSWORD=

# Port the program runs on (http://localhost:3000/admin)
PORT=3000

# Where the database is stored (default: data/orders.db inside this folder). Back this file up!
# DB_FILE=C:\ButcherOrders\orders.db

# ---- Stripe (online payments) ----
# Paid Stripe Checkout / Payment Link orders appear on the "Online orders" tab automatically.
# Create a *restricted* key in Stripe: Dashboard → Developers → API keys → Create restricted key, with:
#   Checkout Sessions: Write   (read new orders + make payment links for extra weight)
#   Products: Read,  Prices: Read (if listed)
#   Refunds: Write              (refund customers when meat weighs less than paid for)
#   PaymentIntents: Read
# Leave everything else as None. It starts with rk_live_ (or rk_test_ in test mode).
# STRIPE_SECRET_KEY=rk_live_...
#
# Optional, only when this program is hosted online: makes orders appear instantly instead of within a minute.
# Dashboard → Developers → Webhooks → Add endpoint → https://YOUR-SITE/api/stripe/webhook
# with event "checkout.session.completed", then paste its signing secret here.
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Where customers land after paying an extra-weight payment link (e.g. your website):
# STRIPE_SUCCESS_URL=https://www.example.com

# ---- Pickup time slots ----
# Customers pick a half-hour pickup slot between these times (24-hour clock). The last slot starts 30 min before close.
# PICKUP_OPEN=10:00
# PICKUP_CLOSE=18:00
# PICKUP_SLOT_MINUTES=30
# Most orders per slot customers can book online (staff can still add more). 0 = no limit.
# PICKUP_SLOT_MAX=10
# Days with no pickups (comma-separated: mon,tue,…). Leave blank to open every day.
# PICKUP_CLOSED_DAYS=mon
# Different hours for one day of the week (Sunday defaults to 10:00-15:00):
# PICKUP_HOURS_SUN=10:00-15:00
# PICKUP_HOURS_SAT=09:00-17:00
