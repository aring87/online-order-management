# Settings for the orders program. Copy this file to ".env" (the start scripts do this for you) and edit.

# Password for the orders program.
# Leave blank for no login screen — the program is then only reachable from this computer.
# Set a password to use it from other devices (tablet, phone) or when hosting it online.
ADMIN_PASSWORD=

# Port the program runs on (http://localhost:3000/admin)
PORT=3000

# Where the database is stored (default: data/orders.db inside this folder). Back this file up!
# DB_FILE=C:\ButcherOrders\orders.db

# ---- Stripe (online payments) ----
# Paid Stripe Checkout / Payment Link orders appear on the "Online orders" tab automatically.
# Create a *restricted* key in Stripe: Dashboard → Developers → API keys → Create restricted key,
# with READ access to "Checkout Sessions" and "Products" (nothing else needed). It starts with rk_live_.
# STRIPE_SECRET_KEY=rk_live_...
#
# Optional, only when this program is hosted online: makes orders appear instantly instead of within a minute.
# Dashboard → Developers → Webhooks → Add endpoint → https://YOUR-SITE/api/stripe/webhook
# with event "checkout.session.completed", then paste its signing secret here.
# STRIPE_WEBHOOK_SECRET=whsec_...
